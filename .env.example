STUDIO_SERVER_URL=http://localhost:8790
PAYLOAD_API_URL=http://localhost:3000/api
KYRON_STUDIO_LOGIN_URL=http://localhost:3000/it/studio/login

# Cookie kyron-rev cross-subdomain: deve coincidere con KYRON_REVIEW_SECRET di Kyron
KYRON_REVIEW_SECRET=

# Payload API key per service-to-service (lettura PendingSchools server-side).
# Creazione: Payload admin -> Users -> "Crea utente" email "studio-service@kyronedu.it"
# role: service -> apri il record, genera API Key. Incolla qui il valore.
STUDIO_PAYLOAD_API_KEY=

# DEV ONLY — bypass auth se la PROD usa cookie cross-subdomain.
# Setta a tua email per iterare in locale senza login.
# In production NON settare.
STUDIO_DEV_USER=alek@kyronedu.it
